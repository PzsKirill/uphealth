<section class="science" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">
    <div class="science__card">
      {%- if section.settings.video_url != blank -%}
        <video class="science__video" autoplay muted loop playsinline preload="metadata"{% if section.settings.poster != blank %} poster="{{ section.settings.poster }}"{% endif %}>
          <source src="{{ section.settings.video_url }}" type="video/mp4" />
        </video>
      {%- elsif section.settings.image != blank -%}
        <img class="science__video" src="{{ section.settings.image | image_url: width: 1600 }}" alt="" loading="lazy" />
      {%- endif -%}
      <div class="science__overlay">
        {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="science__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="science__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UpHealth video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside every capsule" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Science, but make it simple" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Smooth, glossy capsules dosed to the milligram — what goes in is exactly what your body can use." },
    { "type": "header", "content": "Media" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "default": "https://assets.mixkit.co/videos/35377/35377-720.mp4" },
    { "type": "text", "id": "poster", "label": "Poster URL", "default": "https://assets.mixkit.co/videos/35377/35377-thumb-720-0.jpg" },
    { "type": "image_picker", "id": "image", "label": "Image (fallback if no video)" }
  ],
  "presets": [{ "name": "UpHealth video" }]
}
{% endschema %}
