{%- comment -%}
  UpHealth ad landing — NMN Capsules.
  Standalone page landing (page.nmn-landing template) with native Shopify buy.
  Reads the product (handle nmn-1) via all_products + its custom.content JSON.
  Cloned from uphealth-landing-creatine; recoloured to the NMN jar (periwinkle / lavender / violet).
{%- endcomment -%}
{%- assign product = all_products[section.settings.product_handle] -%}
{%- assign d = product.metafields.custom.content.value -%}
{%- liquid
  assign sub_grp = null
  for g in product.selling_plan_groups
    assign sub_grp = g
    break
  endfor
  assign plan_a = null
  assign plan_b = null
  if sub_grp != null
    for pl in sub_grp.selling_plans
      if forloop.first
        assign plan_a = pl
      else
        assign plan_b = pl
      endif
    endfor
  endif
  assign v1 = product.variants.first
  assign v3 = null
  if product.variants.size > 1
    assign v3 = product.variants[1]
  endif
  assign price_a = 0
  if plan_a != null
    for a in v1.selling_plan_allocations
      if a.selling_plan.id == plan_a.id
        assign price_a = a.per_delivery_price
      endif
    endfor
  endif
  assign price_b = 0
  if plan_b != null and v3 != null
    for a in v3.selling_plan_allocations
      if a.selling_plan.id == plan_b.id
        assign price_b = a.per_delivery_price
      endif
    endfor
  endif
  # buy-box (.pack) colours read from the SAME source as the product page for 1:1 parity
  assign pack_accent = d.colors.accent | default: '#6b7fb0'
  assign pack_bg = d.colors.bg | default: '#edeff5'
-%}

