  /* ===== Sticky add-to-cart bar (landing only) — replaces the docked promo-bar ===== */
  .promo-bar.is-docked { display: none !important; }
  #lp-{{ section.id }} .lp-atc { position: fixed; left: 0; right: 0; bottom: 0; z-index: 55; background: #fff; border-top: 1px solid var(--lp-line, #e6e7ef); box-shadow: 0 -12px 30px -20px rgba(20,22,50,.55); transform: translateY(115%); transition: transform .34s cubic-bezier(.4,0,.2,1); padding: 10px 0 max(10px, env(safe-area-inset-bottom)); }
  #lp-{{ section.id }} .lp-atc.is-visible { transform: translateY(0); }
  #lp-{{ section.id }} .lp-atc__inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  #lp-{{ section.id }} .lp-atc__info { display: flex; align-items: center; gap: 12px; min-width: 0; }
  #lp-{{ section.id }} .lp-atc__thumb { width: 46px; height: 46px; border-radius: 10px; object-fit: cover; flex: none; background: var(--lp-band); }
  #lp-{{ section.id }} .lp-atc__txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  #lp-{{ section.id }} .lp-atc__txt strong { font-size: .98rem; font-weight: 600; color: var(--lp-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #lp-{{ section.id }} .lp-atc__price { font-size: 1.02rem; font-weight: 700; color: var(--lp-ink); }
  #lp-{{ section.id }} .lp-atc__btn { flex: none; padding: 13px 40px; font-size: 1rem; }
  @media (max-width: 640px) {
    #lp-{{ section.id }} .lp-atc { padding-top: 8px; }
    #lp-{{ section.id }} .lp-atc__inner { gap: 12px; }
    #lp-{{ section.id }} .lp-atc__thumb { width: 40px; height: 40px; }
    #lp-{{ section.id }} .lp-atc__txt strong { font-size: .9rem; }
    #lp-{{ section.id }} .lp-atc__price { font-size: .95rem; }
    #lp-{{ section.id }} .lp-atc__btn { padding: 12px 22px; font-size: .95rem; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('lp-{{ section.id }}');
    if (!root) return;
    (function () {
      var track = root.querySelector('[data-gallery-track]');
      if (!track) return;
      var n = track.children.length;
      var nav = Array.prototype.slice.call(root.querySelectorAll('[data-gallery-go]'));
      var prev = root.querySelector('[data-gallery-prev]'), next = root.querySelector('[data-gallery-next]'), gi = 0;
      function go(idx) { gi = Math.max(0, Math.min(n - 1, idx)); track.style.transform = 'translateX(' + (-gi * 100) + '%)'; nav.forEach(function (b, k) { b.classList.toggle('is-active', k === gi); }); if (prev) prev.classList.toggle('is-disabled', gi === 0); if (next) next.classList.toggle('is-disabled', gi === n - 1); }
      if (prev) prev.addEventListener('click', function () { go(gi - 1); });
      if (next) next.addEventListener('click', function () { go(gi + 1); });
      nav.forEach(function (b) { b.addEventListener('click', function () { go(parseInt(b.getAttribute('data-gallery-go'), 10)); }); });
      go(0);
    })();
    var form = root.querySelector('form');
    if (!form) return;
    var routine = form.querySelector('[data-routine]');
    var moneyFormat = {{ shop.money_format | json }};
    function formatMoney(cents) {
      cents = Math.round(cents || 0);
      var withDec = (cents / 100).toFixed(2), whole = Math.round(cents / 100).toString();
      return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/g, function (m, n) {
        if (n === 'amount_no_decimals' || n === 'amount_no_decimals_with_comma_separator') return whole;
        if (n === 'amount_with_comma_separator') return withDec.replace('.', ',');
        return withDec;
      });
    }
    if (routine) {
      var cards = Array.prototype.slice.call(routine.querySelectorAll('.pack'));
      var idInput = form.querySelector('[data-form-id]'), planInput = form.querySelector('[data-form-plan]');
      var priceNow = form.querySelector('[data-price-now]'), priceOld = form.querySelector('[data-price-old]');
      var atcPrice = root.querySelector('[data-atc-price]');
      function num(el, a) { return parseInt((el && el.getAttribute(a)) || '0', 10); }
      function select(card) {
        if (!card) return;
        cards.forEach(function (c) { c.classList.toggle('is-active', c === card); });
        var r = card.querySelector('input[type=radio]'); if (r) r.checked = true;
        if (idInput) idInput.value = card.getAttribute('data-id') || '';
        if (planInput) planInput.value = card.getAttribute('data-plan') || '';
        var price = num(card, 'data-price'), compare = num(card, 'data-compare');
        if (priceNow) priceNow.textContent = formatMoney(price);
        if (atcPrice) atcPrice.textContent = formatMoney(price);
        if (priceOld) { if (compare > price) { priceOld.textContent = formatMoney(compare); priceOld.hidden = false; } else { priceOld.hidden = true; } }
      }
      cards.forEach(function (c) {
        c.addEventListener('click', function () { select(c); });
        var r = c.querySelector('input[type=radio]'); if (r) r.addEventListener('change', function () { select(c); });
      });
      select(routine.querySelector('.pack.is-active') || cards[0]);
    }

    // ===== Sticky add-to-cart bar (landing only) =====
    var atc = root.querySelector('[data-atc]');
    if (atc) {
      var atcAdd = atc.querySelector('[data-atc-add]');
      if (atcAdd) atcAdd.addEventListener('click', function () {
        var submit = form.querySelector('[name=add], button[type=submit]');
        if (submit && !submit.disabled) { submit.click(); }
        else if (form.requestSubmit) { form.requestSubmit(); }
        else { form.submit(); }
      });
      var heroEl = root.querySelector('.lp-hero');
      var buyBox = root.querySelector('.lp-buy');
      var footerEl = document.querySelector('.footer') || document.querySelector('footer');
      var scroller = document.querySelector('.page-wrapper');
      function atcScrollTop() {
        if (scroller && scroller.scrollHeight > scroller.clientHeight + 4) return scroller.scrollTop;
        return window.pageYOffset || document.documentElement.scrollTop || 0;
      }
      function atcSync() {
        var show = heroEl ? (heroEl.getBoundingClientRect().bottom < 80) : (atcScrollTop() > 480);
        if (show && buyBox) {
          var r = buyBox.getBoundingClientRect();
          if (r.top < window.innerHeight - 60 && r.bottom > 80) show = false;
        }
        if (show && footerEl && footerEl.getBoundingClientRect().top < window.innerHeight + 80) show = false;
        atc.classList.toggle('is-visible', show);
        atc.setAttribute('aria-hidden', show ? 'false' : 'true');
      }
      window.addEventListener('scroll', atcSync, { passive: true });
      if (scroller) scroller.addEventListener('scroll', atcSync, { passive: true });
      window.addEventListener('resize', atcSync, { passive: true });
      atcSync();
    }
  })();
</script>

