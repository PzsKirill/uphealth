              {%- for i in (1..5) -%}<span class="lp-rev__star{% if i > block.settings.stars %} is-off{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2l2.94 6.36 6.86.86-5.06 4.71 1.34 6.79L12 18.5 5.98 21l1.34-6.79L2.26 9.42l6.86-.86z"/></svg></span>{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="lp-rev__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="lp-rev__text">{{ block.settings.text }}</p>
            <div class="lp-rev__foot">
              {%- if block.settings.date != blank -%}<span class="lp-rev__tag">{{ block.settings.date }}</span>{%- endif -%}
              <span class="lp-rev__tag lp-rev__tag--verified"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Verified purchase</span>
            </div>
          </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== BUY (Build your routine — gallery + subscription buy-box) ===== {%- endcomment -%}
  <section class="lp-buy" id="buy">
    <div class="lp-wrap">
      <header class="lp-head lp-head--center">
        <span class="lp-eyebrow">Start today</span>
        <h2 class="lp-h2">Start your <em>routine</em></h2>
        <p class="lp-sub">One capsule a day. Subscribe and save — skip or cancel anytime.</p>
      </header>
      <div class="lp-pdp">
        <div class="lp-gallery">
          <div class="up-gallery" data-gallery>
            <div class="up-gallery__viewport">
              <div class="up-gallery__track" data-gallery-track>
                {%- for media in product.media -%}<div class="up-gallery__slide"><img src="{{ media | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy" /></div>
                {%- else -%}{%- if product.featured_media -%}<div class="up-gallery__slide"><img src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" /></div>{%- endif -%}{%- endfor -%}
              </div>
            </div>
            {%- if product.media.size > 1 -%}
              <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
              <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
          <div class="up-gallery-nav" data-gallery-nav>
            {%- for media in product.media -%}<button type="button" class="up-gallery-nav__item{% if forloop.first %} is-active{% endif %}" data-gallery-go="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"><img src="{{ media | image_url: width: 300 }}" alt="" loading="lazy" /></button>{%- endfor -%}
          </div>
          {%- endif -%}
        </div>
        <div class="lp-info">
          {%- if d.rating != blank -%}<p class="lp-stars"><span aria-hidden="true">★★★★★</span> {{ d.rating }}</p>{%- endif -%}
          <h3 class="lp-buy__title">NMN <em>Capsules</em></h3>
          {%- if d.benefits -%}
          <ul class="lp-checks">
            {%- for b in d.benefits -%}
            <li><svg class="lp-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ b }}</li>
            {%- endfor -%}
          </ul>
          {%- endif -%}

          {%- form 'product', product -%}
            <span class="lp-field-label">Choose your plan</span>
            <div class="packs uphealth" data-routine>
              <label class="pack is-active" data-id="{{ v1.id }}" data-plan="" data-price="{{ v1.price }}">
                <input type="radio" name="rt" checked>
                <span class="pack__radio" aria-hidden="true"></span>
                <span class="pack__body"><span class="pack__name">1 bottle · <em>one-time</em></span><span class="pack__note">Try it once — no commitment</span></span>
                <span class="pack__price"><span class="pack__now">{{ v1.price | money }}</span></span>
              </label>
              {%- if plan_a != null and price_a > 0 -%}
              <label class="pack" data-id="{{ v1.id }}" data-plan="{{ plan_a.id }}" data-price="{{ price_a }}" data-compare="{{ v1.price }}">
                <span class="pack__badge">Save 10%</span>
                <input type="radio" name="rt">
                <span class="pack__radio" aria-hidden="true"></span>
                <span class="pack__body"><span class="pack__name">1 bottle · <em>monthly</em></span><span class="pack__note">Delivered every month · cancel anytime</span></span>
                <span class="pack__price"><span class="pack__now">{{ price_a | money }}<small class="pack__per">/mo</small></span><span class="pack__old">{{ v1.price | money }}</span></span>
              </label>
              {%- endif -%}
              {%- if plan_b != null and v3 != null and price_b > 0 -%}
              <label class="pack" data-id="{{ v3.id }}" data-plan="{{ plan_b.id }}" data-price="{{ price_b }}" data-compare="{{ v3.price }}">
                <span class="pack__badge">Best value · Save 15%</span>
                <input type="radio" name="rt">
                <span class="pack__radio" aria-hidden="true"></span>
                <span class="pack__body"><span class="pack__name">3 bottles · <em>every 3 months</em></span><span class="pack__note">3-month supply · ships quarterly</span></span>
                <span class="pack__price"><span class="pack__now">{{ price_b | money }}<small class="pack__per">/3 mo</small></span><span class="pack__old">{{ v3.price | money }}</span></span>
              </label>
              {%- endif -%}
            </div>
            <input type="hidden" name="id" value="{{ v1.id }}" data-form-id>
            <input type="hidden" name="selling_plan" value="" data-form-plan>

            <div class="lp-buy__cta">
              <span class="lp-price"><span class="lp-price__now" data-price-now>{{ v1.price | money }}</span><span class="lp-price__old" data-price-old hidden></span></span>
              <button type="submit" name="add" class="lp-btn lp-btn--lg lp-btn--block"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
            </div>
            <p class="lp-reassure">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Free shipping over $40
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Skip or cancel anytime
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Made in the USA
            </p>
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== CROSS-SELL (protein products marquee → product pages) ===== {%- endcomment -%}
  <section class="lp-xsell">
    <div class="lp-wrap">
      <header class="lp-head lp-head--center">
        <span class="lp-eyebrow">Complete your stack</span>
        <h2 class="lp-h2">Build your <em>longevity stack</em></h2>
        <p class="lp-sub">NMN works best alongside the cellular-health essentials. Add one to your daily routine.</p>
      </header>
    </div>
    <div class="lp-xsell__strip">
      <div class="lp-xsell__track">
        {%- assign xh = "resveratrol-50-600mg-1;coq10-ubiquinone-1;grass-fed-hydrolyzed-collagen-peptides-1;complete-multivitamin-1;magnesium-glycinate-1" | split: ";" -%}
        {%- for pass in (1..4) -%}
          {%- for h in xh -%}
            {%- assign xp = all_products[h] -%}
            {%- if xp != empty and xp.id -%}
            <a class="lp-xcard" href="{{ xp.url }}"{% if pass > 1 %} tabindex="-1" aria-hidden="true"{% endif %}>
              <span class="lp-xcard__media">
                <span class="lp-xcard__tag">Longevity</span>
                {%- if xp.featured_media -%}<img src="{{ xp.featured_media | image_url: width: 500 }}" alt="{{ xp.title | escape }}" loading="lazy" width="260" height="260">{%- endif -%}
              </span>
              <span class="lp-xcard__info">
                <span class="lp-xcard__name">{{ xp.title }}</span>
                <span class="lp-xcard__row">
                  <span class="lp-xcard__price">{{ xp.price | money }}</span>
                  <span class="lp-xcard__go">View&nbsp;→</span>
                </span>
              </span>
            </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== FAQ (accordion) ===== {%- endcomment -%}
  {%- assign faq = d.faq -%}
  {%- if faq.items -%}
  <script type="application/ld+json">
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for f in faq.items -%}{ "@type": "Question", "name": {{ f.q | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | strip_html | strip_newlines | json }} } }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  ] }
  </script>
  <section class="lp-faq">
    <div class="lp-wrap lp-wrap--narrow">
      <header class="lp-head lp-head--center">
        <h2 class="lp-h2">{{ faq.title | default: 'Good to know' }}</h2>
      </header>
      <div class="lp-faq-list">
        {%- for f in faq.items -%}
        <details class="lp-faq-item"{% if forloop.first %} open{% endif %}>
          <summary>{{ f.q }}<span class="lp-faq-ic" aria-hidden="true"></span></summary>
          <div class="lp-faq-a"><p>{{ f.a }}</p></div>
        </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== FINAL CTA ===== {%- endcomment -%}
  <section class="lp-final">
    <div class="lp-wrap lp-final__inner">
      <h2 class="lp-h2">Age well, <em>from the cells up.</em></h2>
      <p class="lp-sub">500&nbsp;mg of pure NMN, one capsule a day — start your longevity routine today.</p>
      <a class="lp-btn lp-btn--lg" href="#buy">Get NMN</a>
      <p class="lp-reassure lp-reassure--center">Free shipping over $40 · Skip or cancel anytime · Made in the USA</p>
    </div>
  </section>

  {%- comment -%} Sticky add-to-cart bar — landing only; replaces the docked promo-bar {%- endcomment -%}
  <div class="lp-atc" data-atc aria-hidden="true">
    <div class="lp-wrap lp-atc__inner">
      <div class="lp-atc__info">
        {%- if product.featured_media -%}<img class="lp-atc__thumb" src="{{ product.featured_media | image_url: width: 128 }}" alt="" width="46" height="46" loading="lazy">{%- endif -%}
        <span class="lp-atc__txt"><strong>{{ product.title }}</strong><span class="lp-atc__price" data-atc-price>{{ v1.price | money }}</span></span>
      </div>
      <button type="button" class="lp-btn lp-atc__btn" data-atc-add aria-label="Add {{ product.title | escape }} to cart">Add to cart</button>
    </div>
  </div>

</div>

<style>
  #lp-{{ section.id }} {
    --lp-paper: #f5f6fc; --lp-band: #e3e5f2; --lp-ink: #2a3057; --lp-muted: #5d6488;
    --lp-btn: #414a86; --lp-btn-hover: #333b6e; --lp-accent: #7a6fc4; --lp-card: #ffffff;
    --lp-line: rgba(41,48,90,.14); --lp-radius: 18px;
    /* map global .pack tokens to the landing palette */
    --color-purple: var(--lp-btn); --color-purple-soft: #b7bfdd; --color-purple-deep: #333b6e;
    --color-border: var(--lp-line); --color-bg-card: #fff; --color-bg: var(--lp-band);
    --color-text: var(--lp-ink); --color-text-muted: var(--lp-muted); --color-accent: var(--lp-btn);
    font-family: "Hanken Grotesk", system-ui, sans-serif; color: var(--lp-ink); background: var(--lp-paper);
  }
  #lp-{{ section.id }} * { box-sizing: border-box; }
  #lp-{{ section.id }} .lp-wrap { max-width: 1480px; margin-inline: auto; padding-inline: clamp(18px, 4vw, 48px); }
  #lp-{{ section.id }} em { font-family: "Fraunces", Georgia, serif; font-style: italic; font-weight: 500; }
  #lp-{{ section.id }} .lp-h1 { font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.05; letter-spacing: -.02em; font-weight: 700; margin: 6px 0 12px; }
  #lp-{{ section.id }} .lp-h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.1; letter-spacing: -.02em; font-weight: 700; margin: 0 0 10px; }
  #lp-{{ section.id }} .lp-h1 em, #lp-{{ section.id }} .lp-h2 em { color: var(--lp-accent); }
  #lp-{{ section.id }} .lp-sub, #lp-{{ section.id }} .lp-body { color: var(--lp-muted); font-size: 1.05rem; line-height: 1.6; margin: 0; }
  #lp-{{ section.id }} .lp-eyebrow { font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--lp-muted); margin: 0 0 4px; }
  #lp-{{ section.id }} .lp-eyebrow--accent { color: var(--lp-accent); }

  /* hero (informational, centered) */
  #lp-{{ section.id }} .lp-hero { background: radial-gradient(120% 90% at 50% 0%, var(--lp-band) 0%, var(--lp-paper) 66%); overflow: hidden; text-align: center; padding-block: clamp(30px, 4.5vw, 60px) clamp(48px, 7vw, 96px); }
  #lp-{{ section.id }} .lp-hero__inner { display: flex; flex-direction: column; align-items: center; }
  #lp-{{ section.id }} .lp-hero__eyebrow { font-size: .82rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--lp-accent); margin: 0 0 14px; }
  #lp-{{ section.id }} .lp-hero__title { font-size: clamp(2.2rem, 5.6vw, 4.2rem); line-height: 1.03; letter-spacing: -.02em; font-weight: 700; margin: 0; text-wrap: balance; }
  #lp-{{ section.id }} .lp-hero__title em { color: var(--lp-accent); }
  #lp-{{ section.id }} .lp-hero__lead { max-width: 56ch; margin: 18px auto 0; color: var(--lp-muted); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.55; }
  #lp-{{ section.id }} .lp-hero__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
  #lp-{{ section.id }} .lp-hero__checks { list-style: none; padding: 0; display: flex; gap: 10px 28px; justify-content: center; flex-wrap: wrap; margin: 20px 0 0; font-size: .92rem; font-weight: 500; color: var(--lp-muted); }
  #lp-{{ section.id }} .lp-hero__checks li { display: flex; gap: 7px; align-items: center; }
  #lp-{{ section.id }} .lp-hero__stage { position: relative; margin-top: 22px; width: 100%; padding-inline: clamp(12px, 4vw, 40px); }
  #lp-{{ section.id }} .lp-hero__cluster { width: min(600px, 98%, 74vh); height: auto; margin: 0 auto; display: block; filter: drop-shadow(0 34px 40px rgba(41,48,90,.22)); }
  #lp-{{ section.id }} .lp-hero__cluster--photo { width: min(520px, 94%, 66vh); border-radius: 28px; box-shadow: 0 44px 84px -44px rgba(41,48,90,.5); filter: none; }
  #lp-{{ section.id }} .lp-hero__legal { margin: 0; padding-block: 18px 6px; font-size: .78rem; color: var(--lp-muted); }

  /* buttons */
  #lp-{{ section.id }} .lp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 30px; border: 0; border-radius: 999px; background: var(--lp-btn); color: #fff; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; transition: background .15s ease, transform .15s ease, box-shadow .15s ease; }
  #lp-{{ section.id }} .lp-btn:hover { background: var(--lp-btn-hover); transform: translateY(-1px); }
  #lp-{{ section.id }} .lp-btn--lg { padding: 16px 34px; font-size: 1.05rem; }
  #lp-{{ section.id }} .lp-btn--block { flex: 1; }
  #lp-{{ section.id }} .lp-btn--ghost { background: transparent; color: var(--lp-btn); box-shadow: inset 0 0 0 1.5px var(--lp-line); }
  #lp-{{ section.id }} .lp-btn--ghost:hover { background: #fff; color: var(--lp-btn); box-shadow: inset 0 0 0 1.5px var(--lp-btn); }

  /* pdp (inside the buy section) */
  #lp-{{ section.id }} .lp-pdp { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  #lp-{{ section.id }} .lp-gallery { margin: 0; position: sticky; top: 20px; }
  #lp-{{ section.id }} .lp-gallery .up-gallery__viewport { border-radius: var(--lp-radius); box-shadow: 0 24px 60px -34px rgba(18,50,95,.4); }
  #lp-{{ section.id }} .lp-gallery .up-gallery-nav__item.is-active { border-color: var(--lp-btn); }
  #lp-{{ section.id }} .lp-gallery .gallery__arrow { background: rgba(255,255,255,.9); color: var(--lp-btn); box-shadow: 0 6px 18px -8px rgba(18,50,95,.5); }
  #lp-{{ section.id }} .lp-stars { margin: 0 0 12px; font-size: .95rem; color: var(--lp-muted); }
  #lp-{{ section.id }} .lp-stars span { color: #e6a53a; letter-spacing: 1px; }
  #lp-{{ section.id }} .lp-checks { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 9px; }
  #lp-{{ section.id }} .lp-checks li { display: flex; gap: 10px; align-items: flex-start; font-size: .96rem; }
  #lp-{{ section.id }} .lp-check { width: 18px; height: 18px; flex: none; color: var(--lp-accent); margin-top: 1px; }
  #lp-{{ section.id }} .lp-field-label { display: block; font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--lp-muted); margin-bottom: 12px; }
  #lp-{{ section.id }} .lp-price { display: flex; flex-direction: column; }
  #lp-{{ section.id }} .lp-price__now { font-size: 1.7rem; font-weight: 700; }
  #lp-{{ section.id }} .lp-price__old { font-size: .95rem; color: var(--lp-muted); text-decoration: line-through; }
  #lp-{{ section.id }} .lp-reassure { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 14px 0 0; font-size: .82rem; color: var(--lp-muted); }
  #lp-{{ section.id }} .lp-reassure svg { width: 14px; height: 14px; color: var(--lp-accent); vertical-align: -2px; }
  #lp-{{ section.id }} .lp-reassure--center { justify-content: center; }

  /* buy section */
  #lp-{{ section.id }} .lp-buy { background: var(--lp-paper); padding-block: clamp(40px, 6vw, 72px); }
  #lp-{{ section.id }} .lp-buy__title { margin: 0 0 14px; font-size: 1.5rem; font-weight: 700; }
  #lp-{{ section.id }} .lp-buy__title em { color: var(--lp-accent); }
  #lp-{{ section.id }} .lp-buy__cta { display: flex; align-items: center; gap: 16px; margin-top: 18px; }

  /* buy-box 1:1 with the product page — remap the .pack colour tokens to the SAME accent/bg the universal template computes (scoped to .packs so the rest of the landing keeps its navy) */
  #lp-{{ section.id }} .packs {
    --color-purple: {{ pack_accent }};
    --color-purple-soft: color-mix(in srgb, {{ pack_accent }} 22%, white);
    --color-purple-deep: color-mix(in srgb, {{ pack_accent }} 70%, black);
    --color-border: color-mix(in srgb, {{ pack_accent }} 20%, white);
    --color-bg: {{ pack_bg }};
    --color-bg-card: color-mix(in srgb, {{ pack_bg }} 35%, white);
    --color-text: color-mix(in srgb, {{ pack_accent }} 72%, black);
    --color-text-muted: color-mix(in srgb, color-mix(in srgb, {{ pack_accent }} 72%, black) 55%, {{ pack_bg }});
  }

  /* photo strip (product photography marquee) */
  #lp-{{ section.id }} .lp-photos { overflow: hidden; padding-block: 0; background: var(--lp-paper); }
  #lp-{{ section.id }} .lp-photos__track { display: flex; width: max-content; animation: lp-photoscroll-{{ section.id }} 52s linear infinite; }
  #lp-{{ section.id }} .lp-photos:hover .lp-photos__track { animation-play-state: paused; }
  #lp-{{ section.id }} .lp-photos__tile { flex: none; width: 430px; height: 600px; overflow: hidden; background: var(--lp-band); border-radius: var(--lp-radius); margin-right: 20px; }
  #lp-{{ section.id }} .lp-photos__tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @keyframes lp-photoscroll-{{ section.id }} { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { #lp-{{ section.id }} .lp-photos__track { animation: none; } }

  /* sections */
  #lp-{{ section.id }} .lp-benefits, #lp-{{ section.id }} .lp-science, #lp-{{ section.id }} .lp-compare, #lp-{{ section.id }} .lp-howto, #lp-{{ section.id }} .lp-chart, #lp-{{ section.id }} .lp-ingredients, #lp-{{ section.id }} .lp-reviews, #lp-{{ section.id }} .lp-faq, #lp-{{ section.id }} .lp-results, #lp-{{ section.id }} .lp-experts { padding-block: clamp(40px, 6vw, 72px); }
  #lp-{{ section.id }} .lp-wrap--narrow { max-width: 760px; }
  #lp-{{ section.id }} .lp-eyebrow { display: inline-block; font-size: .8rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--lp-accent); margin-bottom: 10px; }
  #lp-{{ section.id }} .lp-head { max-width: 640px; margin-bottom: 32px; }
  #lp-{{ section.id }} .lp-head--center { margin-inline: auto; text-align: center; }
  #lp-{{ section.id }} .lp-head--wide { max-width: 860px; }
  #lp-{{ section.id }} .lp-head--wide .lp-h2 { text-wrap: balance; }
  #lp-{{ section.id }} .lp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  #lp-{{ section.id }} .lp-card { background: var(--lp-card); border: 1px solid var(--lp-line); border-radius: var(--lp-radius); padding: 34px 26px 30px; text-align: center; }
  #lp-{{ section.id }} .lp-art { display: grid; place-items: center; width: 128px; height: 128px; margin: 0 auto 18px; border-radius: 50%; background: var(--lp-band); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--lp-btn) 16%, transparent), 0 14px 30px -20px rgba(18,50,95,.55); }
