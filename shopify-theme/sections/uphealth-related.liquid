{%- liquid
  assign coll = section.settings.collection
  unless coll
    assign coll = product.collections.first
  endunless
-%}
{%- if coll and coll.products.size > 1 -%}
<section class="pdp-related">
  <div class="container">
    <header class="section-head section-head--center">
      {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </header>
    <div class="catalog__grid-products">
      {%- assign shown = 0 -%}
      {%- for p in coll.products -%}
        {%- if p.id != product.id and shown < section.settings.limit -%}
          {% render 'uphealth-product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "UpHealth related",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Source (defaults to product's collection)" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 }
  ],
  "presets": [{ "name": "UpHealth related" }]
}
{% endschema %}
