<section class="perfect-day" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">
    <header class="product-line__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="product-line__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--ghost btn--sm">{{ section.settings.button_label }}</a>{%- endif -%}
    </header>

    <div class="perfect-day__grid">
      {%- for block in section.blocks -%}
      <article class="day-card" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="day-card__media">
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
          {%- elsif block.settings.asset != blank -%}<img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" />{%- endif -%}
          {%- if block.settings.time != blank -%}<span class="day-card__time">{{ block.settings.time }}</span>{%- endif -%}
        </a>
        <div class="day-card__body">
          <h3 class="day-card__title">{{ block.settings.title }}</h3>
          <div class="day-card__footer">
            {%- if block.settings.price != blank -%}<span class="product-card__price-now">{{ block.settings.price }}</span>{%- endif -%}
            <a href="{{ block.settings.link | default: '#' }}" class="btn btn--primary btn--sm">Details</a>
          </div>
        </div>
      </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UpHealth perfect day",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your daily routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formula for the perfect day" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "More options" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "day", "name": "Day card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Image — asset fallback" },
      { "type": "text", "id": "time", "label": "Time label" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "price", "label": "Price" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{
    "name": "UpHealth perfect day",
    "blocks": [
      { "type": "day", "settings": { "asset": "matchalatte.png", "time": "Morning", "title": "Matcha Latte", "price": "$29" } },
      { "type": "day", "settings": { "asset": "bcomplex.png", "time": "Day", "title": "B-Complex", "price": "$39" } },
      { "type": "day", "settings": { "asset": "magnesiumcalm.png", "time": "Evening", "title": "Magnesium Calm", "price": "$25" } }
    ]
  }]
}
{% endschema %}
