<section class="states-shop" aria-label="{{ section.settings.title | escape }}">
  <div class="container">
    <header class="section-head section-head--center">
      {%- if section.settings.title != blank -%}<h2 class="section-head__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<p class="section-head__lead">{{ section.settings.lead }}</p>{%- endif -%}
    </header>

    <div class="state-tabs" role="tablist">
      <button class="state-tab is-active" data-filter="all" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="6.5" r="2.5"/><circle cx="6.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span>All</button>
      <button class="state-tab" data-filter="energy" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 5 13h6l-1 9 8-12h-6l1-8z"/></svg></span>Energy &amp; Stamina</button>
      <button class="state-tab" data-filter="immune" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span>Immune Support</button>
      <button class="state-tab" data-filter="strength" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10"/></svg></span>Strength &amp; Muscle Recovery</button>
      <button class="state-tab" data-filter="focus" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.3 1 2.1V16h6v-.4c0-.8.4-1.5 1-2.1A6 6 0 0 0 12 3z"/></svg></span>Memory, Focus &amp; Cognitive Support</button>
      <button class="state-tab" data-filter="mood" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c10 2 16-4 16-15-9 0-16 4-16 13z"/><path d="M4 20c2-5 5-8 9-10.5"/></svg></span>Mood &amp; Relaxation</button>
      <button class="state-tab" data-filter="sleep" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>Sleep &amp; Rest</button>
      <button class="state-tab" data-filter="metabolic" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 18a8 8 0 1 1 15 0"/><circle cx="12" cy="18" r="1.4"/><path d="m12 18 3.6-3.8"/></svg></span>Metabolic Health &amp; Weight Support</button>
      <button class="state-tab" data-filter="liver" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5s5.5 5.2 5.5 9.5a5.5 5.5 0 0 1-11 0c0-4.3 5.5-9.5 5.5-9.5z"/><path d="M9.5 13a2.5 2.5 0 0 0 2.5 2.5"/></svg></span>Liver Health</button>
      <button class="state-tab" data-filter="joint" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 10c.7-.7 1.69 0 2.5 0a2.5 2.5 0 1 0 0-5 .5.5 0 0 1-.5-.5 2.5 2.5 0 1 0-5 0c0 .81.7 1.8 0 2.5l-7 7c-.7.7-1.69 0-2.5 0a2.5 2.5 0 0 0 0 5c.28 0 .5.22.5.5a2.5 2.5 0 1 0 5 0c0-.81-.7-1.8 0-2.5z"/></svg></span>Joint &amp; Bone Health</button>
      <button class="state-tab" data-filter="beauty" role="tab"><span class="state-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/></svg></span>Hair, Skin &amp; Nail Health</button>
    </div>

    {%- assign coll = section.settings.collection | default: collections.all -%}
    <div class="product-line__grid" id="state-grid-{{ section.id }}">
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- assign states = '' -%}
        {%- for c in product.collections -%}{%- if c.handle contains 'state-' -%}{%- assign s = c.handle | remove: 'state-' -%}{%- assign states = states | append: ' ' | append: s -%}{%- elsif c.handle == 'metabolic-health-weight-support' -%}{%- assign states = states | append: ' metabolic' -%}{%- elsif c.handle == 'liver-health' -%}{%- assign states = states | append: ' liver' -%}{%- elsif c.handle == 'joint-bone-health' -%}{%- assign states = states | append: ' joint' -%}{%- elsif c.handle == 'hair-skin-nail-health' -%}{%- assign states = states | append: ' beauty' -%}{%- endif -%}{%- endfor -%}
        {%- for tag in product.tags -%}{%- if tag contains 'state:' -%}{%- assign s = tag | remove: 'state:' | strip -%}{%- assign states = states | append: ' ' | append: s -%}{%- endif -%}{%- endfor -%}
        <div class="states-shop__item" data-state-card data-state="{{ states | strip }}">{% render 'uphealth-product-card', product: product %}</div>
      {%- else -%}
        <p class="catalog__empty">Add products to this collection to populate the grid.</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.btn_label != blank -%}
    <div class="product-line__more">
      <a href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.btn_label }}</a>
    </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.state-tab');
    var cards = root.querySelectorAll('[data-state-card]');
    Array.prototype.forEach.call(tabs, function (tab) {
      tab.addEventListener('click', function () {
        Array.prototype.forEach.call(tabs, function (t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        var f = tab.getAttribute('data-filter');
        Array.prototype.forEach.call(cards, function (c) {
          var data = ' ' + (c.getAttribute('data-state') || '') + ' ';
          var show = f === 'all' || data.indexOf(' ' + f + ' ') !== -1;
          c.style.display = show ? '' : 'none';
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "UpHealth states shop",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "What state do you need?" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Pick an outcome — we'll show the formulas that fit." },
    { "type": "collection", "id": "collection", "label": "Source collection (defaults to all products)" },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 2, "label": "Max products", "default": 12 },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Load more" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "UpHealth states shop" }]
}
{% endschema %}
