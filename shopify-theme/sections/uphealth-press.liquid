<section class="press-strip" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">
    <header class="section-head section-head--center">
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
    </header>
    <ul class="press-strip__list">
      {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><a class="press-strip__logo" href="{{ block.settings.link | default: '#' }}"{% if block.settings.link contains '//' %} target="_blank" rel="nofollow noopener"{% endif %}>{{ block.settings.name }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "UpHealth press",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the press" }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "text", "id": "name", "label": "Wordmark" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{
    "name": "UpHealth press",
    "blocks": [
      { "type": "logo", "settings": { "name": "THE WELL" } },
      { "type": "logo", "settings": { "name": "VITALIS" } },
      { "type": "logo", "settings": { "name": "PURE" } },
      { "type": "logo", "settings": { "name": "FORMULA" } },
      { "type": "logo", "settings": { "name": "GLOW JOURNAL" } }
    ]
  }]
}
{% endschema %}
