<section class="bonus" aria-label="Loyalty bonus">
  <div class="container">
    <div class="bonus__card">
      <div class="bonus__body">
        <h2 class="bonus__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="bonus__text">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
      <div class="bonus__visual" aria-hidden="true">
        <div class="bonus__media">
          {%- if section.settings.video_url != blank -%}
            <video autoplay muted loop playsinline preload="metadata"><source src="{{ section.settings.video_url }}" type="video/mp4" /></video>
          {%- elsif section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="" loading="lazy" />
          {%- endif -%}
        </div>
        {%- if section.settings.coin != blank -%}<span class="bonus__coin">{{ section.settings.coin }}</span>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UpHealth bonus",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Bonus on your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We give you 500 bonus points just for creating an account — that's $5 toward day one." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "coin", "label": "Coin badge", "default": "+500" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "video_url", "label": "Video URL (.mp4, overrides image)" }
  ],
  "presets": [{ "name": "UpHealth bonus" }]
}
{% endschema %}
