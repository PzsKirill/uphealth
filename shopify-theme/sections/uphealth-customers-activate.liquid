<style>body { background: var(--color-bg); }</style>

<section class="auth">
  <div class="container">
    <div class="auth__card">
      <h1 class="auth__title">Activate your account</h1>
      <p class="auth__sub">Create a password to finish setting up your account.</p>
      {%- form 'activate_customer_password', class: 'auth__form' -%}
        {%- if form.errors -%}<div class="auth__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="auth__field">
          <label for="activate-pass">Password</label>
          <input type="password" id="activate-pass" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="auth__field">
          <label for="activate-confirm">Confirm password</label>
          <input type="password" id="activate-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Activate account</button>
        <button type="submit" name="decline" class="btn btn--ghost btn--full auth__decline">Decline invitation</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "UpHealth activate", "tag": "section", "settings": [] }
{% endschema %}
