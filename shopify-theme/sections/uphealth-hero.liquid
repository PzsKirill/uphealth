{%- comment -%} UpHealth hero — clean re-feel-style slider. Self-contained: markup + style + JS. {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.css" />

<section class="uh-hero" aria-label="Hero" style="--uh-dot: {{ section.settings.dot_color | default: '#cbc6bf' }}; --uh-dot-active: {{ section.settings.dot_active_color | default: '#74548e' }};">
  <div class="uh-hero__track" id="uh-hero-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign fit = block.settings.image_fit | default: 'contain'
        assign img = ''
        if block.settings.image != blank
          assign img = block.settings.image | image_url: width: 1100
        elsif block.settings.image_url != blank
          assign img = block.settings.image_url
        elsif block.settings.asset != blank
          assign img = block.settings.asset | asset_url
        endif
      -%}
      <article class="uh-hero__slide uh-hero__slide--{{ block.settings.color_scheme }}"
        style="{% if block.settings.bg_color != blank %}background:{{ block.settings.bg_color }};{% endif %}{% if block.settings.accent_color != blank %}--uh-accent:{{ block.settings.accent_color }};{% endif %}"
        {{ block.shopify_attributes }}>
        <div class="uh-hero__inner">
          <div class="uh-hero__copy">
            {%- if block.settings.eyebrow != blank -%}<span class="uh-hero__badge">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h2 class="uh-hero__title">{{ block.settings.title }}</h2>
            {%- if block.settings.lead != blank -%}<p class="uh-hero__lead">{{ block.settings.lead }}</p>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}<a class="uh-hero__cta" href="{{ block.settings.cta_link | default: '#' }}">{{ block.settings.cta_label }}</a>{%- endif -%}
          </div>
          <div class="uh-hero__figure">
            {%- if img != blank -%}<img class="uh-hero__img uh-hero__img--{{ fit }}" src="{{ img }}" alt="{{ block.settings.title | strip_html | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" />{%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<style>
  .uh-hero { position: relative; overflow: hidden; background: #f2ece1; }
  .uh-hero__track { visibility: hidden; }
  .uh-hero__track.slick-initialized { visibility: visible; }

  .uh-hero__slide { outline: none; height: 600px; overflow: hidden; }
  .uh-hero__slide--cream { background: #f2ece1; --uh-accent: #a8754e; }
  .uh-hero__slide--peach { background: #f9e8d6; --uh-accent: #c2691f; }
  .uh-hero__slide--mint  { background: #e4f1ec; --uh-accent: #2f8067; }
  .uh-hero__slide--pink  { background: #fae7ef; --uh-accent: #c14d81; }
  .uh-hero__slide--blue  { background: #e9f0fa; --uh-accent: #3f639e; }

  .uh-hero__inner {
    max-width: 1560px; margin: 0 auto; height: 600px;
    padding-inline: clamp(20px, 5vw, 72px);
    display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px;
  }

  .uh-hero__copy { position: relative; z-index: 2; max-width: 540px; }

  .uh-hero__badge {
    display: inline-block; margin-bottom: 22px; padding: 9px 22px;
    border: 1.5px solid var(--uh-accent); border-radius: 999px;
    color: var(--uh-accent); font-size: 15px; font-weight: 700; letter-spacing: 0.01em;
  }
  .uh-hero__title {
    margin: 0 0 14px; font-family: var(--font-display, inherit);
    font-size: clamp(2rem, 3vw, 3rem); font-weight: 600; line-height: 1.04;
    letter-spacing: -0.03em; color: #2a2622;
  }
  .uh-hero__title em { display: block; font-style: normal; font-weight: 500; color: var(--uh-accent); }
  .uh-hero__lead { margin: 0 0 26px; max-width: 440px; font-size: 17px; line-height: 1.55; color: #4a453f; }
  .uh-hero__cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 14px 30px; color: #fff;
    background: var(--uh-accent);
    background: color-mix(in srgb, var(--uh-accent) 82%, #000);
    font-size: var(--fs-md); font-weight: 500; white-space: nowrap;
    border-radius: var(--radius-pill); text-decoration: none;
    transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .uh-hero__cta:hover { background: color-mix(in srgb, var(--uh-accent) 70%, #000); transform: translateY(-2px); }

  .uh-hero__figure { position: relative; height: 100%; align-self: stretch; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .uh-hero__img { display: block; width: 100%; height: 100%; max-height: 600px; }
  .uh-hero__img--contain { object-fit: contain; padding: 0; }
  .uh-hero__img--cover { object-fit: cover; object-position: center 22%; }

  .uh-hero .slick-dots {
    position: absolute; bottom: 26px; left: 0; right: 0;
    display: flex !important; justify-content: center; gap: 8px;
    margin: 0; padding: 0; list-style: none; z-index: 4;
  }
  .uh-hero .slick-dots li { line-height: 0; }
  .uh-hero .slick-dots button {
    width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%;
    background: var(--uh-dot, rgba(42, 38, 32, 0.22)); font-size: 0; color: transparent; cursor: pointer; transition: all .2s ease;
  }
  .uh-hero .slick-dots li.slick-active button { width: 30px; border-radius: 5px; background: var(--uh-dot-active, #74548e); }
  .uh-hero .slick-dots button::before { display: none; }

  @media (max-width: 900px) {
    .uh-hero__slide { height: auto; }
    .uh-hero__inner { height: auto; grid-template-columns: 1fr; gap: 24px; padding-block: 40px 64px; }
    .uh-hero__figure { order: -1; height: auto; }
    .uh-hero__img { height: 320px; }
    .uh-hero__img--contain { padding-block: 0; }
    .uh-hero__copy { max-width: none; }
  }
</style>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
  (function () {
    var SEL = '#uh-hero-{{ section.id }}';
    function init() {
      var $ = window.jQuery;
      if (!$) { return setTimeout(init, 60); }
      var $h = $(SEL);
      if (!$h.length || $h.hasClass('slick-initialized')) return;
      $h.slick({
        dots: {{ section.settings.show_dots | default: true }},
        arrows: false,
        fade: true,
        autoplay: {{ section.settings.autoplay | default: true }},
        autoplaySpeed: {{ section.settings.autoplay_speed | default: 6000 }},
        speed: 700,
        pauseOnHover: false,
        cssEase: 'cubic-bezier(0.16, 1, 0.3, 1)',
        adaptiveHeight: false
      });
    }
    init();
    document.addEventListener('shopify:section:load', function () { if (window.jQuery) window.jQuery(init); });
  })();
</script>

{% schema %}
{
  "name": "UpHealth hero",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3000, "max": 9000, "step": 500, "unit": "ms", "label": "Autoplay speed", "default": 6000 },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "color", "id": "dot_color", "label": "Dot colour", "default": "#cbc6bf" },
    { "type": "color", "id": "dot_active_color", "label": "Active dot colour", "default": "#74548e" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "color_scheme", "label": "Background preset", "default": "cream", "options": [
          { "value": "cream", "label": "Cream" },
          { "value": "peach", "label": "Peach" },
          { "value": "mint", "label": "Mint" },
          { "value": "pink", "label": "Pink" },
          { "value": "blue", "label": "Blue" }
        ] },
        { "type": "color", "id": "bg_color", "label": "Background colour", "info": "Set to match the image background." },
        { "type": "color", "id": "accent_color", "label": "Accent colour", "info": "Badge / heading accent / button." },
        { "type": "text", "id": "eyebrow", "label": "Badge (New / Новинка)" },
        { "type": "inline_richtext", "id": "title", "label": "Title", "info": "Wrap the 2nd line in <em> for the accent colour." },
        { "type": "textarea", "id": "lead", "label": "Lead" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Order now" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        { "type": "header", "content": "Image" },
        { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [
          { "value": "contain", "label": "Contain (product floats)" },
          { "value": "cover", "label": "Cover (fills panel)" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image (upload)" },
        { "type": "text", "id": "image_url", "label": "Image URL (CDN)" },
        { "type": "text", "id": "asset", "label": "Image asset (theme file)" }
      ]
    }
  ],
  "presets": [
    { "name": "UpHealth hero", "blocks": [ { "type": "slide" } ] }
  ]
}
{% endschema %}
