<script>
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;

    function setH() { document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px'); }

    // Sticky header + docking promo. IMPORTANT: Horizon makes `.page-wrapper` the
    // scroll container on desktop (height:100dvh; overflow-y:auto), so the page
    // scrolls inside that div, not the window. Listen on it (and window as a
    // fallback) and read the correct scrollTop, or nothing ever fires.
    var spacer = document.querySelector('.header-spacer');
    var promoBar = document.querySelector('.promo-bar');
    var scroller = document.querySelector('.page-wrapper');
    var footerEl = null;
    function scrollY() {
      if (scroller && scroller.scrollHeight > scroller.clientHeight + 4) return scroller.scrollTop;
      return window.pageYOffset || document.documentElement.scrollTop || 0;
    }
    function onScroll() {
      var y = scrollY();
      var stuck = y > 60;
      if (spacer) { spacer.style.height = header.offsetHeight + 'px'; spacer.style.display = stuck ? 'block' : 'none'; }
      header.classList.toggle('is-stuck', stuck);
      if (promoBar) {
        footerEl = footerEl || document.querySelector('.footer');
        var footerVisible = footerEl ? footerEl.getBoundingClientRect().top < window.innerHeight : false;
        promoBar.classList.toggle('is-docked', stuck && !footerVisible);
      }
    }
    setH();
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    if (scroller) scroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { setH(); onScroll(); }, { passive: true });

    // ----- desktop dropdowns -----
    var items = Array.prototype.slice.call(header.querySelectorAll('.header__nav-item--has-menu'));
    var canHover = window.matchMedia('(hover: hover)').matches;
    var closeTimer = null;
    function closeAll(except) {
      items.forEach(function (it) {
        if (it === except) return;
        it.classList.remove('is-open');
        var b = it.querySelector('.header__nav-link--button');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }
    function open(it) {
      closeAll(it);
      it.classList.add('is-open');
      var b = it.querySelector('.header__nav-link--button');
      if (b) b.setAttribute('aria-expanded', 'true');
    }
    items.forEach(function (it) {
      var b = it.querySelector('.header__nav-link--button');
      if (!b) return;
      b.addEventListener('click', function (e) {
        e.preventDefault();
        clearTimeout(closeTimer);
        var isOpen = it.classList.contains('is-open');
        closeAll();
        if (!isOpen) open(it);
      });
      it.addEventListener('mouseenter', function () { if (canHover) { clearTimeout(closeTimer); open(it); } });
      it.addEventListener('mouseleave', function () { if (canHover) { clearTimeout(closeTimer); closeTimer = setTimeout(function () { closeAll(); }, 220); } });
    });
    document.addEventListener('click', function (e) { if (!e.target.closest('.header__nav-item--has-menu')) closeAll(); });

    // ----- mobile burger + drawer -----
    var burger = document.getElementById('burger');
    var mobileNav = document.getElementById('mobile-nav');
    function closeMobile() {
      if (!mobileNav || !burger) return;
      mobileNav.classList.remove('is-open');
      burger.classList.remove('is-active');
      burger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('is-nav-open');
    }
    if (burger && mobileNav) {
      burger.addEventListener('click', function () {
        var openNow = mobileNav.classList.toggle('is-open');
        burger.classList.toggle('is-active', openNow);
        burger.setAttribute('aria-expanded', openNow ? 'true' : 'false');
        document.body.classList.toggle('is-nav-open', openNow);
        if (openNow) {
          // Sit flush under the header's actual bottom (no promo gap, any scroll state)
          var hb = header.getBoundingClientRect().bottom;
          mobileNav.style.top = hb + 'px';
          mobileNav.style.height = (window.innerHeight - hb) + 'px';
        }
      });
      mobileNav.querySelectorAll('.mobile-nav__link, .mobile-nav__sub a').forEach(function (l) {
        l.addEventListener('click', closeMobile);
      });
    }
    header.querySelectorAll('.mobile-nav__group').forEach(function (g) {
      var t = g.querySelector('.mobile-nav__group-toggle');
      if (!t) return;
      t.addEventListener('click', function () {
        var openNow = g.classList.toggle('is-open');
        t.setAttribute('aria-expanded', openNow ? 'true' : 'false');
      });
    });

    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeAll(); closeMobile(); } });
  })();
</script>

