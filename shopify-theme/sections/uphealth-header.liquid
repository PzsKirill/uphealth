          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="brand-logo" />
        {%- else -%}
          <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" class="brand-logo" />
        {%- endif -%}
      </a>

      <button class="header__burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>

