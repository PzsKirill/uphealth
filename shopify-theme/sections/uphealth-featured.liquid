<section class="product-line" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">
    <header class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.lead != blank -%}<p class="section-head__lead">{{ section.settings.lead }}</p>{%- endif -%}
    </header>

    {%- assign coll = section.settings.collection -%}
    {%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}
    <div class="product-line__grid">
      {%- for p in coll.products limit: section.settings.max_products -%}
        {% render 'uphealth-product-card', product: p %}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
    <div class="product-line__more">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.button_label }}</a>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UpHealth featured",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our community" },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "collection", "id": "collection", "label": "Collection (defaults to all products)" },
    { "type": "range", "id": "max_products", "min": 2, "max": 12, "step": 1, "label": "Max products", "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Load more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "UpHealth featured" }]
}
{% endschema %}
