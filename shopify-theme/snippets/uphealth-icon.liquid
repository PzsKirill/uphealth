{%- comment -%} Maps an icon key → inline SVG. Usage: {% render 'uphealth-icon', key: 'waves' %} {%- endcomment -%}
{%- liquid
  assign k = key | default: 'spark'
  assign o = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">'
  assign c = '</svg>'
-%}
{%- case k -%}
  {%- when 'waves' -%}{{ o }}<path d="M2 8c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 13c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>{{ c }}
  {%- when 'leaf' -%}{{ o }}<path d="M4 20c10 2 16-4 16-15-9 0-16 4-16 13z"/><path d="M4 20c2-5 5-8 9-10.5"/>{{ c }}
  {%- when 'sprout' -%}{{ o }}<path d="M12 22V11M12 11c0-3-2-5-6-5 0 3 2 5 6 5zM12 11c0-3 2-5 6-5 0 3-2 5-6 5zM9 22h6"/>{{ c }}
  {%- when 'spark' -%}{{ o }}<path d="M13 2 5 13h6l-1 9 8-12h-6l1-8z"/>{{ c }}
  {%- when 'shield' -%}{{ o }}<path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/>{{ c }}
  {%- when 'atom' -%}{{ o }}<circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="10" ry="4.5"/><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(120 12 12)"/>{{ c }}
  {%- when 'pulse' -%}{{ o }}<path d="M3 12h4l2-6 4 12 2-6h6"/>{{ c }}
  {%- when 'drop' -%}{{ o }}<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>{{ c }}
  {%- when 'flame' -%}{{ o }}<path d="M12 3s5 4 5 9a5 5 0 0 1-10 0c0-2 1-3 1-3s1 1 2 1c0-3 2-7 2-7z"/>{{ c }}
  {%- when 'clock' -%}{{ o }}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{{ c }}
  {%- when 'sun' -%}{{ o }}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/>{{ c }}
  {%- when 'dumbbell' -%}{{ o }}<path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10"/>{{ c }}
  {%- when 'shaker' -%}{{ o }}<path d="M6 2h12M7 2l1 6a4 4 0 0 0 8 0l1-6M8 14h8M9 22h6"/>{{ c }}
  {%- when 'check' -%}{{ o }}<path d="M20 6 9 17l-5-5"/>{{ c }}
  {%- else -%}{{ o }}<path d="M13 2 5 13h6l-1 9 8-12h-6l1-8z"/>{{ c }}
{%- endcase -%}
