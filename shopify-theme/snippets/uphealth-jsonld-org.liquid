{%- comment -%}
  Organization + WebSite structured data (schema.org).
  Rendered once on the homepage — establishes the brand entity and sitelinks search box.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "UpHealth",
  "alternateName": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "logo": {{ 'logo.svg' | asset_url | prepend: 'https:' | json }},
  "description": "UpHealth makes clean, science-backed supplements — creatine, NMN, magnesium, collagen and more — in meaningful doses, third-party tested and made in GMP-certified USA labs.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "email": "hello@uphealth.life"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "UpHealth",
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
