{%- liquid
  assign root = routes.root_url
  assign all = routes.all_products_collection_url
-%}

<header class="header" id="site-header">
  <div class="header__inner container">

    <div class="header__left">
      <a href="{{ root }}" class="header__logo" aria-label="{{ shop.name }} home">
        <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" class="brand-logo" />
      </a>

      <button class="header__burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>

      <nav class="header__nav" aria-label="Primary navigation">
        <ul class="header__nav-list">

          <li class="header__nav-item header__nav-item--has-menu" data-menu="catalog" data-page="collection">
            <button class="header__nav-link header__nav-link--button" aria-expanded="false" aria-controls="menu-catalog">
              Catalog <span class="header__nav-caret">&#9662;</span>
            </button>
            <div class="mega-menu mega-menu--catalog" id="menu-catalog" role="region" aria-label="Product catalog">
              <div class="mega-menu__inner mega-menu__inner--catalog">

                <div class="mega-cat">
                  <a href="{{ all }}" class="mega-cat__title">All products <span class="mega-cat__title-arrow" aria-hidden="true">&rarr;</span></a>
                  <ul class="mega-cat__links">
                    <li><a href="{{ root }}collections/sticks"  class="mega-cat__link">Sticks</a></li>
                    <li><a href="{{ root }}collections/drinks"  class="mega-cat__link">Drinks</a></li>
                    <li><a href="{{ root }}collections/gummies" class="mega-cat__link">Gummies</a></li>
                    <li><a href="{{ root }}collections/protein" class="mega-cat__link">Protein</a></li>
                    <li><a href="{{ root }}collections/sale"    class="mega-cat__link">Sale</a></li>
                    <li><a href="{{ root }}collections/bundles" class="mega-cat__link">Bundles</a></li>
                    <li><a href="{{ root }}collections/gift"    class="mega-cat__link">Gift cards</a></li>
                  </ul>
                </div>

                <div class="mega-cards">
                  <a class="mega-card" href="{{ all }}">
                    <span class="mega-card__media">
                      <img src="{{ 'photo_2026-06-01_10-27-57.jpg' | asset_url }}" alt="" loading="lazy" />
                    </span>
                    <span class="mega-card__foot">
                      <span class="mega-card__label">Vanilla Whey Protein</span>
                      <span class="mega-card__arrow" aria-hidden="true">&rarr;</span>
                    </span>
                  </a>
                  <a class="mega-card mega-card--gift" href="{{ root }}collections/gift">
                    <span class="mega-card__media mega-card__media--gift" aria-hidden="true">
                      <span class="gift-stack">
                        <span class="gift-stack__card gift-stack__card--back"><img src="{{ '100horizontal.png' | asset_url }}" alt="" loading="lazy" /></span>
                        <span class="gift-stack__card gift-stack__card--front"><img src="{{ '150horizontal.png' | asset_url }}" alt="" loading="lazy" /></span>
                      </span>
                    </span>
                    <span class="mega-card__foot">
                      <span class="mega-card__label">Gift cards</span>
                      <span class="mega-card__arrow" aria-hidden="true">&rarr;</span>
                    </span>
                  </a>
                </div>

              </div>
            </div>
          </li>

          <li class="header__nav-item header__nav-item--has-menu" data-menu="states">
            <button class="header__nav-link header__nav-link--button" aria-expanded="false" aria-controls="menu-states">
              Outcomes <span class="header__nav-caret">&#9662;</span>
            </button>
            <div class="mega-menu mega-menu--states" id="menu-states" role="region" aria-label="Wellness states">
              <div class="mega-menu__inner mega-menu__inner--states">
                <div class="mega-states">
                  <span class="mega-states__eyebrow">Pick an outcome</span>
                  <div class="state-pills">
                    <a class="state-pill" data-state="energy" href="{{ root }}collections/state-energy">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 5 13h6l-1 9 8-12h-6l1-8z"/></svg></span>Energy &amp; Stamina
                    </a>
                    <a class="state-pill" data-state="immune" href="{{ root }}collections/state-immune">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span>Immune Support
                    </a>
                    <a class="state-pill" data-state="strength" href="{{ root }}collections/state-strength">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10"/></svg></span>Strength &amp; Muscle Recovery
                    </a>
                    <a class="state-pill" data-state="focus" href="{{ root }}collections/state-focus">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.3 1 2.1V16h6v-.4c0-.8.4-1.5 1-2.1A6 6 0 0 0 12 3z"/></svg></span>Memory, Focus &amp; Cognitive Support
                    </a>
                    <a class="state-pill" data-state="mood" href="{{ root }}collections/state-mood">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c10 2 16-4 16-15-9 0-16 4-16 13z"/><path d="M4 20c2-5 5-8 9-10.5"/></svg></span>Mood &amp; Relaxation
                    </a>
                    <a class="state-pill" data-state="sleep" href="{{ root }}collections/state-sleep">
                      <span class="state-pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>Sleep &amp; Rest
                    </a>
                  </div>
                  <p class="mega-states__hint">Not sure where to start? <a href="{{ root }}pages/wellness-test">Take the wellness test &rarr;</a></p>
                </div>
              </div>
            </div>
          </li>

          <li class="header__nav-item header__nav-item--has-menu" data-menu="about" data-page="page">
            <button class="header__nav-link header__nav-link--button" aria-expanded="false" aria-controls="menu-about">
              About <span class="header__nav-caret">&#9662;</span>
            </button>
            <div class="mega-menu mega-menu--about" id="menu-about" role="region" aria-label="About {{ shop.name }}">
              <div class="mega-menu__inner mega-menu__inner--about">

                <div class="mega-about__col">
                  <h4 class="mega-menu__col-title">Company</h4>
                  <ul class="mega-menu__list">
                    <li><a href="{{ root }}pages/about"   class="mega-menu__link">About us</a></li>
                    <li><a href="#"                       class="mega-menu__link">Wholesale</a></li>
                    <li><a href="{{ root }}pages/bonuses" class="mega-menu__link">Bonuses</a></li>
                    <li><a href="#"                       class="mega-menu__link">Vacancies</a></li>
                  </ul>
                </div>

                <div class="mega-about__col">
                  <h4 class="mega-menu__col-title">Help</h4>
                  <ul class="mega-menu__list">
                    <li><a href="{{ root }}pages/delivery" class="mega-menu__link">Contacts</a></li>
                    <li><a href="{{ root }}pages/faq"      class="mega-menu__link">FAQ</a></li>
                    <li><a href="{{ root }}pages/delivery" class="mega-menu__link">Shipping &amp; returns</a></li>
                    <li><a href="{{ root }}pages/bonuses"  class="mega-menu__link">Loyalty program</a></li>
                  </ul>
                </div>

                <div class="mega-about__contacts">
                  <h4 class="mega-menu__col-title">Talk to us</h4>
                  <ul class="mega-contacts">
                    <li class="mega-contact">
                      <span class="mega-contact__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h3l2 5-2 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A14 14 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg></span>
                      <span class="mega-contact__text">
                        <span class="mega-contact__region">United States</span>
                        <a href="tel:+18885550142" class="mega-contact__value">+1 (888) 555-0142</a>
                      </span>
                    </li>
                    <li class="mega-contact">
                      <span class="mega-contact__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h3l2 5-2 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A14 14 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg></span>
                      <span class="mega-contact__text">
                        <span class="mega-contact__region">Europe</span>
                        <a href="tel:+442079460123" class="mega-contact__value">+44 20 7946 0123</a>
                      </span>
                    </li>
                    <li class="mega-contact">
                      <span class="mega-contact__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
                      <span class="mega-contact__text">
                        <span class="mega-contact__region">Email</span>
                        <a href="mailto:care@uphealth.com" class="mega-contact__value">care@uphealth.com</a>
                      </span>
                    </li>
                  </ul>
                  <div class="mega-social">
                    <a href="https://wa.me/18885550142" class="mega-social__btn" aria-label="WhatsApp">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 12a8 8 0 1 0-15.1 3.6L4 20l4.5-.9A8 8 0 0 0 20 12zm-3 2.4c-.2.5-1 1-1.5 1.1-.4.1-.9.1-1.5-.1l-1.4-.5a8.5 8.5 0 0 1-3.4-3 5.7 5.7 0 0 1-1-2.4c0-.6.2-1.1.5-1.5.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .4.3l.6 1.5c.1.2 0 .4 0 .5l-.3.4-.2.2c-.1.1-.2.2-.1.4l.6 1c.4.7 1 1.2 1.7 1.5l.4.2c.2 0 .3 0 .4-.1l.5-.6c.1-.2.3-.2.5-.1l1.4.7c.2.1.4.2.4.3v.5z"/></svg>
                    </a>
                    <a href="#" class="mega-social__btn" aria-label="Instagram">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
                    </a>
                    <a href="#" class="mega-social__btn" aria-label="YouTube">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5 3-5 3z"/></svg>
                    </a>
                  </div>
                </div>

                <a class="mega-menu__featured mega-about__featured" href="{{ root }}pages/about">
                  <div class="mega-menu__featured-image" aria-hidden="true">
                    <img src="{{ 'photo_2026-06-01_10-28-02.jpg' | asset_url }}" alt="" loading="lazy" />
                  </div>
                  <div class="mega-menu__featured-body">
                    <span class="mega-menu__featured-label">Our story</span>
                    <span class="mega-menu__featured-title">Science you can trust</span>
                    <span class="mega-menu__featured-cta">Read more &rarr;</span>
                  </div>
                </a>

              </div>
            </div>
          </li>
        </ul>

        <a href="{{ root }}pages/wellness-test" class="header__nav-cta" data-no-ripple="true">Wellness Test</a>
      </nav>
    </div>

    <div class="header__right">
      <form class="header__search" role="search" action="{{ routes.search_url }}" method="get">
        <input type="search" name="q" class="header__search-input" placeholder="Search the catalog&hellip;" aria-label="Search the catalog" />
        <button type="submit" class="header__search-btn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span>Find</span>
        </button>
      </form>

      <div class="header__actions">
        <button class="header__icon-btn header__icon-btn--wishlist" id="wishlist-btn" aria-label="Favorites">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-4.5-9.5-9C1 8.5 3.5 5 7 5c2 0 3.5 1 5 3 1.5-2 3-3 5-3 3.5 0 6 3.5 4.5 7-2.5 4.5-9.5 9-9.5 9z"/></svg>
          <span class="header__count header__count--wishlist" id="wishlist-count" aria-hidden="true">0</span>
        </button>
        <a href="{{ routes.cart_url }}" class="header__icon-btn header__icon-btn--cart" id="cart-btn" aria-label="Cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-2 11H8L6 6z"/><path d="M6 6 5 2H2"/><circle cx="10" cy="21" r="1.5"/><circle cx="17" cy="21" r="1.5"/></svg>
          <span class="header__count" aria-hidden="true">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav__inner">
      <form class="header__search" role="search" action="{{ routes.search_url }}" method="get" style="width: 100%; margin-bottom: var(--space-md);">
        <input type="search" name="q" class="header__search-input" placeholder="Search the catalog&hellip;" aria-label="Search the catalog" />
        <button type="submit" class="header__search-btn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
      </form>

      <ul class="mobile-nav__list">
        <li class="mobile-nav__group">
          <button class="mobile-nav__group-toggle" aria-expanded="false">Catalog <span>+</span></button>
          <ul class="mobile-nav__sub">
            <li><a href="{{ all }}">All products</a></li>
            <li><a href="{{ root }}collections/sticks">Sticks</a></li>
            <li><a href="{{ root }}collections/gummies">Gummies</a></li>
            <li><a href="{{ root }}collections/drinks">Drinks</a></li>
            <li><a href="{{ root }}collections/protein">Protein</a></li>
            <li><a href="{{ root }}collections/bundles">Bundles</a></li>
            <li><a href="{{ root }}collections/sale">Sale</a></li>
          </ul>
        </li>
        <li class="mobile-nav__group">
          <button class="mobile-nav__group-toggle" aria-expanded="false">Outcomes <span>+</span></button>
          <ul class="mobile-nav__sub">
            <li><a href="{{ root }}collections/state-energy">Energy &amp; Stamina</a></li>
            <li><a href="{{ root }}collections/state-immune">Immune Support</a></li>
            <li><a href="{{ root }}collections/state-strength">Strength &amp; Muscle Recovery</a></li>
            <li><a href="{{ root }}collections/state-focus">Memory, Focus &amp; Cognitive Support</a></li>
            <li><a href="{{ root }}collections/state-mood">Mood &amp; Relaxation</a></li>
            <li><a href="{{ root }}collections/state-sleep">Sleep &amp; Rest</a></li>
          </ul>
        </li>
        <li class="mobile-nav__group">
          <button class="mobile-nav__group-toggle" aria-expanded="false">About <span>+</span></button>
          <ul class="mobile-nav__sub">
            <li><a href="{{ root }}pages/about">About us</a></li>
            <li><a href="#">Wholesale</a></li>
            <li><a href="{{ root }}pages/bonuses">Bonuses</a></li>
            <li><a href="#">Vacancies</a></li>
            <li><a href="{{ root }}pages/delivery">Contacts</a></li>
            <li><a href="{{ root }}pages/faq">FAQ</a></li>
          </ul>
        </li>
        <li><a href="{{ root }}pages/wellness-test" class="mobile-nav__link">Wellness Test</a></li>
        <li><a href="{{ root }}pages/delivery" class="mobile-nav__link">Shipping</a></li>
      </ul>
      <div class="mobile-nav__footer">
        <a href="{{ routes.account_login_url }}" class="btn btn--ghost btn--full">Sign in</a>
      </div>
    </div>
  </nav>
</header>

<div class="header-spacer" aria-hidden="true"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "paragraph",
      "content": "Skeleton header — nav links use collection/page handles (sticks, gummies, state-energy, /pages/about …). Wire to native linklists in the full build."
    }
  ]
}
{% endschema %}
